      "parameters": {
        "jsCode": "const freeProviders = [\n  'gmail.com',\n  'yahoo.com',\n  'hotmail.com',\n  'outlook.com',\n  'icloud.com'\n];\n\nconst email = $('Edit Fields').first().json.email;\n\nconst domain = email.split('@')[1];\n\nreturn [\n  {\n    json: {\n      ...$('Edit Fields').first().json,\n      email_domain: domain,\n      business_email: !freeProviders.includes(domain),\n      domain_type: freeProviders.includes(domain)\n        ? 'free'\n        : 'business'\n    }\n  }\n];"
      },
